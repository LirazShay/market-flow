{
  "name": "market-flow-local-history-viewer-v2-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Test tooling for the Market Flow Local History Viewer V2 research prototype.",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node tests/unit/run-unit-tests.js",
    "test:browser": "npm run build:runtime && playwright test",
    "test:browser:smoke": "playwright test tests/automation/specs/harness-smoke.spec.js",
    "test:all": "npm run test:unit && npm run test:browser",
    "build:runtime": "node runtime/build-runtime.js",
    "build:engine-manifest": "node runtime/duckdb-engine-manifest.js",
    "test:browser:runtime": "npm run build:runtime && playwright test tests/automation/specs/runtime-assembly.spec.js",
    "build:browser-sql-probe": "node runtime/build-browser-sql-probe.js",
    "test:browser:sql-probe": "npx playwright test tests/automation/specs/browser-sql-probe.spec.js"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "terser": "5.51.2"
  },
  "engines": {
    "node": ">=20"
  }
}
